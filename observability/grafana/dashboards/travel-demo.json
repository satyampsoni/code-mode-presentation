      "id": 1,
      "title": "Exposed tools",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "travel-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "agent_demo_measurement{source=\"recorded\",recording_id=\"$recording\",metric=\"exposedTools\"}",
          "legendFormat": "{{mode}}",
          "instant": false,
          "range": true,
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "travel-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*traditional.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#D97706"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*code.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8B5CF6"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name",
        "displayMode": "basic",
        "showUnfilled": true,
        "sizing": "auto",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
