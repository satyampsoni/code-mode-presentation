{
  "uid": "travel-agent-demo",
  "title": "NitroStack \u00b7 Live agent execution",
  "tags": [
    "nitrostack",
    "mcp",
    "live"
  ],
  "schemaVersion": 41,
  "version": 6,
  "editable": false,
  "refresh": "2s",
  "time": {
    "from": "now-15m",
    "to": "now"
