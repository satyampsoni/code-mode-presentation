    {
      "id": 9,
      "title": "Input tokens \u00b7 Code Mode difference",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "travel-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(agent_demo_measurement{source=\"recorded\",recording_id=\"$recording\",mode=\"traditional\",metric=\"inputTokens\"}) - sum(agent_demo_measurement{source=\"recorded\",recording_id=\"$recording\",mode=\"code\",metric=\"inputTokens\"})) / sum(agent_demo_measurement{source=\"recorded\",recording_id=\"$recording\",mode=\"traditional\",metric=\"inputTokens\"})",
          "instant": true,
          "range": false,
          "legendFormat": "Positive = less; negative = more"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
