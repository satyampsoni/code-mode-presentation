# Copy to .env.local. Never prefix secrets with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional per-million-token prices for your selected model/provider.
# Costs are estimates; include cached input pricing if applicable.
MODEL_INPUT_USD_PER_MILLION=
MODEL_OUTPUT_USD_PER_MILLION=
MODEL_CACHED_INPUT_USD_PER_MILLION=
MODEL_MAX_ROUNDS=12
# Optional, passed only when set; supported parameters vary by provider.
MODEL_MAX_COMPLETION_TOKENS=
DEMO_AGENT_PORT=4100
# Set 1 for shared, rate-limited free providers (serializes model HTTP requests, not tool calls).
MODEL_SERIALIZE_REQUESTS=0
